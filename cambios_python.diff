+    prefix = "./" + path.lstrip("./")
+    os.makedirs(os.path.dirname(prefix) or ".", exist_ok=True)
+    raw = base64.b64decode(data) if isinstance(data, str) else bytes(data)
+    with open(prefix, "wb") as f:
+        f.write(raw)
