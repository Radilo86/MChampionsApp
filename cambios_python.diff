+    def content_vocab(self, r: Request) -> Response:
+        """Everything the card editor (creador.html) offers in its menus, straight from the engine."""
+        import os as _os
+        from engine.browser import content, rules
+        from cards.database import CardsDB
+        def names(folders):
+            out = set()
+            for d in folders:
+                if _os.path.isdir(d):
+                    out.update(f[:-5] for f in _os.listdir(d) if f.endswith(".json"))
+            return sorted(out)
+        villains = sorted({(p.card_id, p.name) for p in CardsDB.papers.values() if p.type == "Villain"}, key=lambda x: x[0])
+        schemes = sorted({(p.card_id, p.name) for p in CardsDB.papers.values() if p.type == "MainScheme" and p.card_id.endswith("a")}, key=lambda x: x[0])
+        return JsonResponse({
+            "phrases": rules.PHRASES,
+            "player_types": sorted(rules.PLAYER_TYPES), "encounter_types": sorted(rules.ENCOUNTER_TYPES),
+            "desc_keys": {t: sorted(k) for t, k in content.desc_keys().items()},
+            "encounter_sets": names(["data/encounter_sets", "data/nemesis", "data/encounter_sets_custom"]),
+            "scenarios": names(["data/scenarios", "data/scenarios_custom"]),
+            "villains": villains, "main_schemes": schemes,
+            "used_ids": sorted(c for c in CardsDB.papers if c.startswith("99")),
+        })
+
+    def content_files(self, r: Request) -> Response:
+        """The files of an installed pack, back in pack layout, so the editor can open and change it."""
+        import os as _os
+        from engine.browser import content
+        pack_id = r.query_string.strip()
+        pack = next((p for p in content.installed() if p.get("id") == pack_id), None)
+        if not pack:
+            return JsonResponse({"error": "no instalado"}, 404)
+        files = {"contenido.json": json.dumps({k: pack.get(k, "") for k in ("id", "nombre", "version", "autor", "descripcion")}, ensure_ascii=False, indent=1)}
+        for target in pack.get("files", []):
+            if not _os.path.exists(target):
+                continue
+            base = _os.path.basename(target)
+            if target.startswith(content.CARDS_FOLDER): rel = "cartas/" + base.split("__", 1)[-1]
+            elif target.startswith(content.SCRIPTS_FOLDER): rel = "cartas/" + base
+            elif target.startswith(content.BOXES_FOLDER): rel = "caja.json"
+            elif target.startswith("data/scenarios_custom/"): rel = "escenarios/" + base
+            elif target.startswith("data/encounter_sets_custom/"): rel = "sets/" + base
