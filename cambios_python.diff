+    def read_json_file(self, file_path: 'str|None', *, do_cache: bool = True) -> Response:
+        if not file_path:
+            return JsonResponse({})
+        if do_cache and file_path in self.json_cache:
+            return Response(self.json_cache[file_path], 200, "application/json")
+        text = Json.Dumps(Json.Load(file_path))
