+    # ================================================================================================================
+    # Synchronisation with the page (get_world / get_ask / post / client_updated / debug)
+    def handle_debug_command(self, r: Request) -> Response:
+        controller = self.get_first_controller(r)
+        controller_manager = controller.manager
+        debug_cmd = Unquote(r.query_string)
+        controller_manager.console.SetCommand(debug_cmd, controller.world)
+        if controller_manager.console.debug_cmds or \
+            controller_manager.console.debug_break or \
+            controller_manager.skip.is_skipping or \
+            controller_manager.skip.skip_to > 0 or \
+            controller_manager.replay.is_updated:
+            self.device_manager.ExitWait()
+        return Response(debug_cmd)
+
+    def handle_client_updated(self, r: Request) -> Response:
+        render_id = int(r.query.get('r', 0))
+        game_id = int(r.query.get('g', 0))
+        for player_id in self.get_player_ids(r):
+            self.device_manager.ClientUpdateRenderId(player_id, render_id, game_id)
+        return Response("", 200)
+
+    def handle_get_ask(self, r: Request) -> Response:
+        dm = self.device_manager
+        if dm.asking_players == []:
+            return JsonResponse({})
+        data = None
+        for player_id in self.get_player_ids(r):
+            if player_id in dm.asking_players:
+                if data is None:
+                    data = asdict(dm.ask_options[player_id])
+                else:
+                    list1 = Json.LoadsAs(data['options_json'], List[Any])
+                    list2 = Json.LoadsAs(asdict(dm.ask_options[player_id])['options_json'], List[Any])
+                    data['options_json'] = Json.Dumps(list1 + list2)
+        if data is None:
+            return JsonResponse({})
+        return Response(json.dumps(data), 200, "application/json")
+
+    def handle_get_world(self, r: Request) -> Response:
+        controller = self.get_first_controller(r)
+        if controller.world:
+            data = controller.world.render.descriptor
+        else:
+            # If we returned {}, the ts code would read null and crash
+            from game.render.descriptor.world import WorldDescriptor
+            data = WorldDescriptor()
+        return Response(Json.Dumps(data), 200, "application/json")
+
+    def handle_post(self, r: Request) -> Response:
+        from engine.browser.validate import validate_decision
+        post_json = Unquote(r.body)
+        player_ids = self.get_player_ids(r)
+        assert len(player_ids) == 1
+        if post_json:
+            for player_id in player_ids:
+                if player_id in self.device_manager.asking_players:
+                    reason = validate_decision(self.device_manager.ask_options[player_id].options_json, post_json)
+                    if reason:
+                        # Certainly invalid (stale / duplicated tap, unpaid cost...): do NOT let it reach the engine, whose
+                        # controller would apply part of it before rejecting it. Ask the page to refresh the question.
+                        Log.Warn(CATEGORY_NAME, f"Decision ignored: {reason}")
+                        if Runtime.bridge is not None:
+                            Runtime.bridge.log(f"[decision ignored] {reason}")
+                        self.device_manager.ask_frame_sent = False
+                        self.device_manager.SendRender(player_id, "GetInput")
+                        self.device_manager.ask_frame_sent = True
+                        return JsonResponse({"ignored": reason})
+                    self.device_manager.WhenInput(post_json, player_id)
+                    self.autosave_dirty = True
+        return Response("", 200)
+
+    # ================================================================================================================
+    # WebSocket emulation
+    def ws_open(self, sid: int, query: str) -> None:
+        request = Request("GET", "ws?" + query)
+        player_ids = self.get_player_ids(request)
+        self.device_manager.client_manager.Add(sid, player_ids, query)
+        if Build.release and ('debug' in request.query or 'show' in request.query):
+            self.game.statistics.SetPause(True)
+        self.controller_manager.replay.SetIsReplay('replay' in request.query)
+
+    def ws_message(self, sid: int, data: str) -> None:
+        if 'mouse_position' in data:
+            return  # a single device: nobody to show our cursor to
+        if data.startswith('Connected'):
+            info = self.device_manager.client_manager.sockets.get(sid)
+            if info and len(info.player_ids) > 0:
+                self.device_manager.SendRender(info.player_ids[0], "websocket_handler")
+            self.device_manager.notify.connect.NotifyAll()
+
+    # ================================================================================================================
+    # Offline-app extras: autosave, saved replays, user decks
+    def autosave(self) -> None:
+        """Called by the device manager right before the engine blocks waiting for a decision."""
+        if not self.autosave_enabled or not self.autosave_dirty:
+            return
+        self.autosave_dirty = False
+        try:
+            game = self.game
+            if not game.state.is_running or game.world is None or game.world.is_game_over:
+                return
+            if game.controller_manager.skip.is_skipping or game.controller_manager.replay.is_replay or game.scene.is_puzzle:
+                return
+            if game.controller_manager.replay.current_step_id < 1:
+                return
+            data = game.session.DumpSave()
+            if os.environ.get("MARVEL_TRACE_AUTOSAVE"):
+                Runtime.bridge.log(f"[autosave] step={game.controller_manager.replay.current_step_id} inputs={len(game.scene.inputs)}")
+            FileManager.MakeDir("./replays")
+            with FileManager.OpenFile("./" + AUTOSAVE_FILE, write=True) as file:
+                file.Write(data)
+        except Exception as exc:
+            Log.FailedTrace(CATEGORY_NAME, exc, no_take_as_error=True)
+            if Runtime.bridge is not None:
+                Runtime.bridge.log(f"[autosave] FAILED: {exc!r}")
+
+    def autosave_info(self, r: Request) -> Response:
+        path = "./" + AUTOSAVE_FILE
+        if not FileManager.Exists(path):
+            return JsonResponse({})
+        try:
+            return self.read_replay_file(path)
+        except Exception as exc:
+            Log.FailedTrace(CATEGORY_NAME, exc, no_take_as_error=True)
+            return JsonResponse({})
+
+    def load_autosave(self, r: Request) -> Response:
+        from game.scene.scene import Scene
+        path = "./" + AUTOSAVE_FILE
+        if not FileManager.Exists(path):
+            return JsonResponse({'error': 'No autosave'}, 404)
+        with FileManager.OpenFile(path, read=True) as file:
+            text = file.Read()
+        scene = Json.LoadsAs(text, Scene)
+        scene.UpdateVersion()
+        self.game.session.LoadScene(scene, -1, 'Load')  # resume exactly at the saved decision
+        self.autosave_dirty = False
+        return JsonResponse({'result': "Loaded"})
+
