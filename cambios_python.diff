+"""
+Content packs: new campaigns / scenarios / encounter sets / cards (+ their scripts and pictures) for the offline app.
+
+A pack is a folder (or a ZIP of it):
+
+    contenido.json        {"id": "mi_campania", "nombre": "Mi campaña", "version": "1", "autor": "...", "descripcion": "..."}
+    caja.json             optional: the box shown in "New Game": {"nombre": "90. Mi campaña", "escenarios": [...], "heroes": [...], "sets": [...]}
+    cartas/*.json         new cards, same format as data/cards.json: {"<pack>": [ {"card_id": "99001", "type": "Minion", ...}, ... ]}
+    cartas/<id>.py        script with the abilities of card <id> (same API as cards/pack/**: see docs/card_scripting_guide.md)
+    escenarios/*.json     scenarios, same format as data/scenarios/*.json
+    sets/*.json           encounter / modular sets, same format as data/encounter_sets/*.json
+    nemesis/*.json        nemesis sets (same format)
+    mazos/*.json          hero decks, same format as deck/starter/*.json
+    imagenes/<id>.jpg     card pictures (.jpg/.png/.webp; landscape schemes are rotated automatically)
+
+`check(files, images)` validates a pack WITH THE ENGINE'S OWN LOADERS and returns where each file must be installed.
+It is used by the app (menu "Importar contenido"), by the build (`build_pwa.py --content`) and by `validar_contenido.py`.
+"""
+import json
+import os
+import re
+import traceback
+from typing import Any, Dict, List, Optional, Tuple
+
+TARGETS = {                                   # pack folder -> engine folder
+    "escenarios": "data/scenarios_custom/",
+    "sets": "data/encounter_sets_custom/",
+    "nemesis": "data/encounter_sets_custom/",
+    "mazos": "deck/",
+}
+CARDS_FOLDER = "data/cards_custom/"
+SCRIPTS_FOLDER = "cards/custom/"
+BOXES_FOLDER = "data/sets_custom/"
+MANIFESTS_FOLDER = "content/"
+ID_RE = re.compile(r"^[a-z0-9][a-z0-9_\-]{1,40}$")
+NAME_RE = re.compile(r"^[A-Za-z0-9_\-\.]+$")
+PICTURE_EXT = (".jpg", ".jpeg", ".png", ".webp")
+
+
+def slug(text: str) -> str:
+    s = re.sub(r"[^a-z0-9_\-]+", "_", text.lower()).strip("_")
+    return s[:40] or "contenido"
+
+
+def _ids(value: Any):
+    for v in value or []:
+        for part in str(v).split(","):
+            if part.strip():
+                yield part.strip()
+
+
+def _load_script(card_id: str, source: str, path: str) -> 'Tuple[Optional[str], int]':
+    """Compile + run a card script exactly like CardsDB does for user scripts; returns (error, number of abilities)."""
+    import ast
+    import importlib.util
+    try:
+        tree = ast.parse(source, filename=path)
+    except SyntaxError as exc:
+        return f"error de sintaxis en la línea {exc.lineno}: {exc.msg}", 0
+
+    class ImportTransformer(ast.NodeTransformer):
+        def visit_ImportFrom(self, node: ast.ImportFrom):
+            if node.module is None and node.names and node.names[0].name == "*":
+                node.module = "cards.pack"; node.level = 0
+            return node
+
+    try:
+        code = compile(ImportTransformer().visit(tree), path, "exec")
+        spec = importlib.util.spec_from_loader(card_id, loader=None)
+        module = importlib.util.module_from_spec(spec)          # type: ignore[arg-type]
+        exec(code, module.__dict__)
+        if not hasattr(module, "GetAbilities"):
+            return "no define la función GetAbilities()", 0
+        abilities = module.GetAbilities()
+        return None, len(abilities)
+    except Exception as exc:
+        tb = traceback.extract_tb(exc.__traceback__)
+        line = next((f.lineno for f in reversed(tb) if f.filename == path), None)
+        return f"{type(exc).__name__}: {exc}" + (f" (línea {line})" if line else ""), 0
+
+
+_desc_keys: Optional[Dict[str, set]] = None
+
+
+def desc_keys() -> Dict[str, set]:
+    """card type -> every "desc" key the official cards of that type use (what the engine accepts)."""
+    global _desc_keys
+    if _desc_keys is None:
+        from cards.database import CardsDB
+        keys: Dict[str, set] = {}
+        for p in CardsDB.papers.values():
+            keys.setdefault(p.type, set()).update((p.desc or {}).keys())
+        _desc_keys = keys
+    return _desc_keys
+
+
+def check(files: Dict[str, str], images: List[str]) -> Dict[str, Any]:
+    """
+    files:  pack-relative path -> text (every file except pictures)
+    images: pack-relative paths of the pictures
+    Returns {"ok", "pack", "errors", "warnings", "plan": {target: source}, "images": {card_id: source}, "summary"}
+    """
+    from cards.database import CardsDB
+    from cards.paper import Paper
+    from engine.lib import Json
+    from engine.file import FileManager
+    from game.scene.replay.campaign import CampaignDescriptor
+    from game.scene.replay.hero import HeroDescriptor
+    from game.scene.replay.encounter_set import EncounterSetDescriptor
+
+    errors: List[str] = []
+    warnings: List[str] = []
