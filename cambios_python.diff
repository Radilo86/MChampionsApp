+    def save_deck(self, r: Request) -> Response:
+        """POST {name, data} -> ./deck/<name>.json (stored in IndexedDB by the host)."""
+        body = json.loads(r.body or "{}")
+        name = FileManager.SanitizeFilename(str(body.get('name', 'deck'))) or 'deck'
+        data = body.get('data')
+        if isinstance(data, (dict, list)):
+            data = json.dumps(data, indent=4)
+        if not isinstance(data, str):
+            return JsonResponse({'error': 'No data'}, 400)
+        json.loads(data)  # must be valid JSON
+        FileManager.MakeDir("./deck")
+        with FileManager.OpenFile(f"./deck/{name}.json", write=True) as file:
+            file.Write(data)
+        return JsonResponse({'result': 'saved', 'path': f"./deck/{name}.json"})
