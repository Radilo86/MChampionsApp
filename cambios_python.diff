+"""
+In-process replacement of the aiohttp server of the desktop version.
+
+`BrowserServer.dispatch(message)` receives messages posted by the page (see `engine/browser/runtime.py`) and answers
+them through the `Bridge`. Every route of `engine/device/web/server/*.py` is implemented here with identical semantics.
+"""
+import json
+import os
+import time
+from urllib.parse import urlsplit, unquote_plus
+from typing import Any, Callable, Dict, List, Optional, Tuple
+
+from core import *
+from build import Build
+from engine.config import ConfigVariables
+from engine.lib import Json, Ver
+from engine.log import Log
+from engine.file import FileManager
+from engine.browser.runtime import Runtime
+from engine.browser.device import BrowserDeviceManager
+
+CATEGORY_NAME = "BROWSER_SERVER"
+
+READ_ONLY_FIRST_REPLAY_FOLDER   = ConfigVariables.Bool('read_only_first_replay_folder', True)
+CARDS_JSON_FILE                 = ConfigVariables.File('cards_json_file')
+REPLAY_FOLDERS                  = ConfigVariables.Folders('replay_folders')
+DECK_FOLDERS                    = ConfigVariables.Folders('deck_folders')
+STARTER_DECK_FOLDER             = ConfigVariables.Folder('starter_deck_folder')
+ENCOUNTER_SETS_FOLDERS          = ConfigVariables.Folders('encounter_sets_folders')
+SCENARIOS_FOLDERS               = ConfigVariables.Folders('scenarios_folders')
+CUSTOM_SCENARIOS_FOLDER         = ConfigVariables.Folder('custom_scenario_folder')
+PUZZLE_FOLDER                   = ConfigVariables.Folder('puzzle_folder')
+PUZZLE_TEST_FOLDER              = ConfigVariables.Folder('puzzle_test_folder')
+
+AUTOSAVE_FILE = "replays/autosave.json"
+
+
+class Request:
+    def __init__(self, method: str, url: str, body: str = "") -> None:
+        parts = urlsplit(url)
+        path = parts.path
+        # The page may be served from a sub-folder (GitHub pages...): only the last route name matters.
+        self.path = "/" + path.strip("/").split("/")[-1] if path.strip("/") else "/"
+        self.method = method.upper()
+        self.raw_query = parts.query
+        self.query_string = unquote_plus(parts.query)
+        self.query: Dict[str, str] = {}
+        for pair in parts.query.split("&"):
+            if not pair:
+                continue
+            key, _, value = pair.partition("=")
+            key = unquote_plus(key)
+            if key not in self.query:
+                self.query[key] = unquote_plus(value)
+        self.body = body
+
+
+class Response:
+    def __init__(self, body: Any = "", status: int = 200, content_type: str = "text/plain") -> None:
+        self.body = body
+        self.status = status
+        self.content_type = content_type
+
+
+def JsonResponse(obj: Any, status: int = 200) -> Response:
+    return Response(json.dumps(obj), status, "application/json")
+
+
+class BrowserServer:
+
+    def __init__(self, device_manager: BrowserDeviceManager) -> None:
+        self.device_manager = device_manager
+        self.json_cache: Dict[str, str] = {}
+        self.autosave_enabled = True
+        self.autosave_dirty = False
+        self.routes: Dict[str, Callable[[Request], Response]] = {
+            '/list_file': self.list_file,
+            '/list_scenarios': self.list_scenarios,
+            '/list_encounter_sets': self.list_encounter_sets,
+            '/list_deck': self.list_deck,
+            '/list_starter_deck': self.list_starter_deck,
+            '/list_replay_files': self.list_replay_files,
+            '/list_puzzle_files': self.list_puzzle_files,
+            '/list_puzzle_test_files': self.list_puzzle_test_files,
+            '/read_file': self.read_file,
+            '/get_encounter_set_json': self.get_encounter_set_json,
+            '/get_scenario_json': self.get_scenario_json,
+            '/get_hero_json': self.get_hero_json,
+            '/get_sets_json': self.get_sets_json,
+            '/get_sets_custom_scenario': self.get_sets_custom_scenario,
+            '/get_cards_json': self.get_cards_json,
+            '/get_translate_json': self.get_translate_json,
+            '/get_card_json': self.get_card_json,
+            '/get_completion_rate': self.get_completion_rate,
+            '/get_statistics': self.get_statistics,
+            '/get_session_statistics': self.get_session_statistics,
+            '/get_play_scene_name': self.get_play_scene_name,
+            '/get_max_timeout': self.get_max_timeout,
+            '/get_puzzle_json': self.get_puzzle_json,
+            '/get_replay_json': self.get_replay_json,
+            '/get_gamers': self.get_gamers,
+            '/get_version': self.get_version,
+            '/new': self.new_game,
+            '/new_debug': self.new_debug,
+            '/load_replay': self.load_replay,
+            '/load_replay_data': self.load_replay_data,
+            '/save_replay_data': self.save_replay_data,
+            '/load_puzzle': self.load_puzzle,
+            '/new_puzzle_replay': self.new_puzzle_replay,
+            '/new_puzzle': self.new_puzzle,
+            '/new_game_online': self.not_available,
+            '/new_game_lan': self.not_available,
+            '/debug': self.handle_debug_command,
+            '/client_updated': self.handle_client_updated,
+            '/get_ask': self.handle_get_ask,
+            '/get_world': self.handle_get_world,
+            '/post': self.handle_post,
+            # Added for the offline app
+            '/autosave_info': self.autosave_info,
+            '/load_autosave': self.load_autosave,
+            '/delete_replay': self.delete_replay,
+            '/save_deck': self.save_deck,
+            '/delete_deck': self.delete_deck,
+            '/list_heroes': self.list_heroes,
+            '/convert_marvelcdb': self.convert_marvelcdb,
+            '/content_check': self.content_check,
+            '/content_vocab': self.content_vocab,
+            '/content_files': self.content_files,
+            '/content_list': self.content_list,
+            '/cards_index_custom': self.cards_index_custom,
+        }
+
+    # ================================================================================================================
+    # Dispatch
+    @property
+    def game(self) -> 'Any':
+        return self.device_manager.game
+
+    @property
+    def controller_manager(self) -> 'Any':
+        return self.device_manager.controller_manager
+
+    def dispatch(self, message: Dict[str, Any]) -> None:
+        kind = message.get("kind")
+        bridge = Runtime.bridge
+        assert bridge is not None
+        if kind == "http":
+            request = Request(message.get("method", "GET"), message["url"], message.get("body") or "")
+            handler = self.routes.get(request.path)
+            if handler is None:
+                bridge.respond(message["id"], 404, "text/plain", f"Not found: {request.path}")
+                return
+            response = handler(request)
+            bridge.respond(message["id"], response.status, response.content_type, response.body)
+        elif kind == "ws_open":
+            self.ws_open(message["sid"], message.get("query", ""))
+        elif kind == "ws_message":
+            self.ws_message(message["sid"], message.get("data", ""))
+        elif kind == "ws_close":
+            self.device_manager.client_manager.Remove(message["sid"])
+        elif kind == "files":
+            # Files restored from IndexedDB at boot (decks, replays, statistics...)
+            for path, data in message.get("files", {}).items():
+                restore_file(path, data)
+        elif kind == "ping":
+            if "id" in message:
+                bridge.respond(message["id"], 200, "text/plain", "pong")
+        else:
