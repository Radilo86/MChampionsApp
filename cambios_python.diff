+    def cards_index_custom(self, r: Request) -> Response:
+        from engine.browser import content
+        return JsonResponse(content.custom_index())
+
+    def list_heroes(self, r: Request) -> Response:
+        from engine.browser import marvelcdb
+        return JsonResponse(marvelcdb.list_heroes())
+
+    def convert_marvelcdb(self, r: Request) -> Response:
+        """POST <MarvelCDB deck json> (or {data: ...}) -> {deck, warnings} | {error}"""
+        from engine.browser import marvelcdb
+        try:
+            body = json.loads(r.body or "{}")
+            if isinstance(body, dict) and "data" in body and "slots" not in body:
+                body = json.loads(body["data"]) if isinstance(body["data"], str) else body["data"]
+            return JsonResponse(marvelcdb.convert(body))
+        except (ValueError, KeyError, TypeError) as exc:
+            return JsonResponse({"error": str(exc)}, 400)
